@HomeInventory.Api_HostAddress = http://localhost:5009
@categoryId = 11111111-1111-1111-1111-111111111111
@brandId = 22222222-2222-2222-2222-222222222222
@supplierId = 33333333-3333-3333-3333-333333333333
@productId = 44444444-4444-4444-4444-444444444444
@purchaseOrderId = 55555555-5555-5555-5555-555555555555
@salesOrderId = 66666666-6666-6666-6666-666666666666

### CATEGORY - GET LIST
GET {{HomeInventory.Api_HostAddress}}/api/categories?pageIndex=1&pageSize=10
Accept: application/json

### CATEGORY - GET BY ID
GET {{HomeInventory.Api_HostAddress}}/api/categories/{{categoryId}}
Accept: application/json

### CATEGORY - CREATE
POST {{HomeInventory.Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Thiết bị bếp",
  "description": "Nhóm sản phẩm cho nhà bếp"
}

### CATEGORY - UPDATE
PUT {{HomeInventory.Api_HostAddress}}/api/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Thiết bị gia dụng",
  "description": "Cập nhật mô tả danh mục"
}

### CATEGORY - DELETE
DELETE {{HomeInventory.Api_HostAddress}}/api/categories/{{categoryId}}

### BRAND - GET LIST
GET {{HomeInventory.Api_HostAddress}}/api/brands?pageIndex=1&pageSize=10
Accept: application/json

### BRAND - GET BY ID
GET {{HomeInventory.Api_HostAddress}}/api/brands/{{brandId}}
Accept: application/json

### BRAND - CREATE
POST {{HomeInventory.Api_HostAddress}}/api/brands
Content-Type: application/json

{
  "name": "Panasonic"
}

### BRAND - UPDATE
PUT {{HomeInventory.Api_HostAddress}}/api/brands/{{brandId}}
Content-Type: application/json

{
  "name": "Panasonic VN"
}

### BRAND - DELETE
DELETE {{HomeInventory.Api_HostAddress}}/api/brands/{{brandId}}

### SUPPLIER - GET LIST
GET {{HomeInventory.Api_HostAddress}}/api/suppliers?pageIndex=1&pageSize=10
Accept: application/json

### SUPPLIER - GET BY ID
GET {{HomeInventory.Api_HostAddress}}/api/suppliers/{{supplierId}}
Accept: application/json

### SUPPLIER - CREATE
POST {{HomeInventory.Api_HostAddress}}/api/suppliers
Content-Type: application/json

{
  "name": "Nhà cung cấp A",
  "phone": "0909123456",
  "address": "Hà Nội",
  "taxCode": "0101234567"
}

### SUPPLIER - UPDATE
PUT {{HomeInventory.Api_HostAddress}}/api/suppliers/{{supplierId}}
Content-Type: application/json

{
  "name": "Nhà cung cấp A - Updated",
  "phone": "0909000000",
  "address": "TP.HCM",
  "taxCode": "0101234567"
}

### SUPPLIER - DELETE
DELETE {{HomeInventory.Api_HostAddress}}/api/suppliers/{{supplierId}}

### PRODUCT SEARCH - PAGING/FILTER
GET {{HomeInventory.Api_HostAddress}}/api/products?brandId={{brandId}}&categoryId={{categoryId}}&model=BL&pageIndex=1&pageSize=20
Accept: application/json

### PURCHASE ORDER IMPORT - CREATE (NEW WORKFLOW)
POST {{HomeInventory.Api_HostAddress}}/api/purchaseorders
Content-Type: application/json

{
  "code": "PO-20260322-001",
  "supplierId": "{{supplierId}}",
  "items": [
    {
      "model": "BL-900",
      "name": "Máy xay sinh tố BL-900",
      "unit": "Cái",
      "quantity": 10,
      "unitCost": 1250000,
      "categoryId": "{{categoryId}}",
      "brandId": "{{brandId}}"
    },
    {
      "model": "BL-901",
      "name": "Máy xay sinh tố BL-901",
      "unit": "Cái",
      "quantity": 5,
      "unitCost": 1450000,
      "categoryId": "{{categoryId}}",
      "brandId": "{{brandId}}"
    }
  ]
}

### SALES ORDER EXPORT - CREATE
POST {{HomeInventory.Api_HostAddress}}/api/salesorders
Content-Type: application/json

{
  "code": "SO-20260322-001",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2,
      "unitPrice": 1800000
    }
  ]
}

### REPORT - IMPORT SUMMARY JSON
GET {{HomeInventory.Api_HostAddress}}/api/reports/import-summary?year=2026&month=3
Accept: application/json

### REPORT - IMPORT SUMMARY EXCEL
GET {{HomeInventory.Api_HostAddress}}/api/reports/import-summary/excel?year=2026&month=3
Accept: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
